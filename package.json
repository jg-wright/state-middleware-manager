    "husky": "^9.1.6",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "vite-node": "^3.2.4",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jg-wright/state-middleware-manager.git"
